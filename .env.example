# Copia este archivo como `.env` y completa los valores reales.
# El archivo `.env` está en .gitignore: NUNCA se sube al repositorio.

# --- App ---
PORT=3000
NODE_ENV=development
# Origen permitido para CORS (el frontend Next.js)
FRONTEND_URL=http://localhost:4000

# --- Base de datos ---
DATABASE_URI=mongodb://localhost:27017/ecommerce

# --- JWT ---
# Genera secretos fuertes, por ejemplo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=cambia-este-secreto
# Vida corta del access token: limita la ventana de abuso si alguien lo roba
JWT_ACCESS_EXPIRES_IN=15m
# Vida del refresh token (sesión). Formato: días, ej. 7d
JWT_REFRESH_EXPIRES_IN=7d

# --- Google OAuth ---
# Client ID de tu app en Google Cloud Console (el mismo que usa el frontend)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Client Secret del mismo cliente OAuth: el backend lo usa para canjear el code
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# --- Cloudinary (imágenes de productos) ---
# Settings → API Keys en https://console.cloudinary.com
# El Cloud name es el identificador en minúsculas (NO "Root", que es el entorno)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=123456789012345
# Secreto: NUNCA en el frontend ni en el repositorio
CLOUDINARY_API_SECRET=xxxxxxxx

# --- Stripe (pagos, MODO PRUEBA) ---
# Dashboard → Desarrolladores → Claves de API (con "Modo de prueba" activado)
# Secreta: permite cobrar y reembolsar. NUNCA en el frontend ni en el repo
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# Solo para webhooks. En local lo da el Stripe CLI:
#   stripe listen --forward-to localhost:3000/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# ─── Correo (Resend) ─────────────────────────────────────────
# API key de https://resend.com/api-keys. Sin ella, los correos solo se
# registran en el log (el checkout funciona igual)
RESEND_API_KEY=re_xxxxxxxx
# Remitente. Sin dominio verificado en Resend solo vale onboarding@resend.dev
# (y solo envía al correo del dueño de la cuenta)
EMAIL_FROM="ÁMBAR <onboarding@resend.dev>"
