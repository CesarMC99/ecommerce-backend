# Copia este archivo como `.env` y completa los valores reales.
# El archivo `.env` está en .gitignore: NUNCA se sube al repositorio.

# --- App ---
PORT=3000
NODE_ENV=development
# Origen permitido para CORS (el frontend Next.js)
FRONTEND_URL=http://localhost:4000

# --- Base de datos ---
DATABASE_URI=mongodb://localhost:27017/ecommerce

# --- JWT ---
# Genera secretos fuertes, por ejemplo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=cambia-este-secreto
# Vida corta del access token: limita la ventana de abuso si alguien lo roba
JWT_ACCESS_EXPIRES_IN=15m
# Vida del refresh token (sesión). Formato: días, ej. 7d
JWT_REFRESH_EXPIRES_IN=7d

# --- Google OAuth ---
# Client ID de tu app en Google Cloud Console (el mismo que usa el frontend)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
